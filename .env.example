# ─────────────────────────────────────────────────────────────
# Bayit environment variables. Copy to .env and fill in.
# Required in every environment: DATABASE_URL, BETTER_AUTH_SECRET,
# APP_ENCRYPTION_KEY, HASH_SALT, NEXT_PUBLIC_SITE_URL.
# Everything else is optional in development (a safe fallback is used).
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Supabase, Neon, or local)
DATABASE_URL="postgresql://bayit:bayit@localhost:5432/bayit"

# Public address of the site, no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Encrypts ID documents and 2-step secrets — generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Salt for hashing IPs/devices in logs — generate with: openssl rand -hex 16
HASH_SALT=""

# ── Login (src/lib/auth) ─────────────────────────────────────
# Google login — https://console.cloud.google.com/apis/credentials (OAuth client, type "Web").
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# The "Continue with Google" button only appears when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple login — https://developer.apple.com/account/resources (a Services ID + a Sign in with Apple key).
# Return URL: <BETTER_AUTH_URL>/api/auth/callback/apple (Apple needs a real https domain).
# APPLE_CLIENT_SECRET is a JWT signed with your Apple key (valid for up to 6 months — renew it).
# APPLE_APP_BUNDLE_IDENTIFIER is only needed for a native iOS app.
# The "Continue with Apple" button only appears when ID and secret are set.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""

# Phone login codes — Twilio Verify (https://console.twilio.com → Verify → Services).
# Without these, development prints the code in the server log and shows it on the login form;
# production refuses to send codes until they are set.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# "sms" (default) or "whatsapp" (needs WhatsApp enabled on the Verify service).
TWILIO_VERIFY_CHANNEL="sms"

# Development only: let staff open /admin without 2-step login. Ignored in production.
DEV_SKIP_STAFF_2FA="false"

# ── Email (src/lib/email) ────────────────────────────────────
# Resend API key — https://resend.com/api-keys. Without it, emails are printed to the server log
# and kept in the admin "email outbox" (status LOGGED) instead of being sent.
RESEND_API_KEY=""
# Sender, on a domain verified in Resend, e.g. "Bayit <no-reply@bayit.example>".
# Defaults to Resend's test sender (onboarding@resend.dev), which only delivers to your own address.
EMAIL_FROM=""

# ── File storage (src/lib/storage) ───────────────────────────
# "local" (default): files under ./storage/public (served at /api/media/…) and ./storage/private.
# "s3": any S3-compatible storage — Cloudflare R2, Supabase Storage, AWS S3, MinIO.
STORAGE_DRIVER="local"
# Optional folder for the local driver (default: ./storage).
STORAGE_LOCAL_DIR=""
# S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com or
# https://<project>.supabase.co/storage/v1/s3. Leave empty for AWS S3.
S3_ENDPOINT=""
# Region: "auto" for R2, your project region for Supabase, e.g. "eu-central-1" for AWS.
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Bucket for listing photos (must be publicly readable).
S3_PUBLIC_BUCKET=""
# Bucket for ID and ownership documents (never public; files are also encrypted with APP_ENCRYPTION_KEY).
S3_PRIVATE_BUCKET=""
# Public base URL of the public bucket, no trailing slash, e.g. https://media.bayit.example or
# https://<project>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL=""
# "true"/"false". Defaults to true when S3_ENDPOINT is set (needed by R2, Supabase and MinIO).
S3_FORCE_PATH_STYLE=""

# ── CAPTCHA (src/lib/turnstile) ──────────────────────────────
# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile → Add widget (mode "Managed").
# Without these, CAPTCHA checks are skipped (forms send the token "dev").
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Visitor IP (src/lib/request) ─────────────────────────────
# Header that holds the real visitor IP behind a proxy you trust, e.g. "cf-connecting-ip" behind
# Cloudflare. On Vercel leave it empty (Vercel's own headers are used). Used for rate limits and logs.
CLIENT_IP_HEADER=""
