    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hebcal/core": "^6.14.7",
    "@hookform/resolvers": "^6.0.2",
    "@marsidev/react-turnstile": "^1.6.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "node-ical": "^0.27.3",
    "nuqs": "^2.10.2",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
