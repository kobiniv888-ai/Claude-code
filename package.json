{
  "name": "bayit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run i18n:check && npm test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --require ./scripts/server-script.cjs prisma/seed/index.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:studio": "prisma studio",
    "demo:remove": "tsx --require ./scripts/server-script.cjs scripts/demo-remove.ts",
    "translate:missing": "tsx --require ./scripts/server-script.cjs scripts/translate-missing.ts",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
