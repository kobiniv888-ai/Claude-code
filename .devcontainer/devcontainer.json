{
  // GitHub Codespaces / VS Code Dev Containers: a ready-to-run Bayit with its own Postgres.
  // On github.com: Code → Codespaces → "Create codespace" (choose this branch). See docs/CODESPACES.md.
  "name": "Bayit",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Bayit website", "onAutoForward": "notify" }
  },
  // Other ports (test servers, Postgres) are never forwarded by themselves (SECURITY_REPORT 2.4.i).
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Every start: the FAST version (production build; builds only when the code changed). The
  // founder tests on a phone, where the development server is slow (round 3).
  "postStartCommand": "bash .devcontainer/start-prod.sh",
  // Opening the editor again: keeps the running site (waits for a start still in progress).
  "postAttachCommand": "bash .devcontainer/start.sh"
}
